# ─────────────────────────────────────────────────────────────
# Precision Core Builders — Environment Variables
# Add these to Netlify dashboard: Site → Environment variables
# For local dev: copy to .env.local (git-ignored)
# ─────────────────────────────────────────────────────────────

# ── Supabase (required for Phase 2: auth + database) ────────
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Client-side (VITE_ prefix = safe to expose in browser)
VITE_SUPABASE_URL=https://[project-ref].supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ── AI (required for Phase 3: estimator, voice reports) ─────
GEMINI_API_KEY=AIza...
OPENAI_API_KEY=sk-...          # Whisper voice transcription

# ── Weather (required for Phase 3: smart scheduling) ────────
OPENWEATHERMAP_API_KEY=...     # Free tier at openweathermap.org

# ── Automation (Phase 4: sub-contractor notifications) ──────
N8N_WEBHOOK_URL=https://...
N8N_API_KEY=...

# ── Billing (Phase 5: milestone invoicing) ──────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ── Application ─────────────────────────────────────────────
NODE_ENV=development
