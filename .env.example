# ─────────────────────────────────────────────────────────────
# Precision Core Builders — Environment Variables
#
# HOW TO USE:
#   Production → Add every variable to the Netlify dashboard:
#                Site → Environment variables
#   Local dev  → Copy this file to .env.local (git-ignored)
#                and fill in real values
#
# ⚠️  NEVER commit real credentials to this file or any other
#     file in the repository. Store secrets in a password
#     manager (1Password, Bitwarden, etc.) and in Netlify only.
# ─────────────────────────────────────────────────────────────

# ── Admin Login (fallback, no database needed) ───────────────────────
# skdev@1commerce.online and erictadlock@precisioncorebuilders.com are
# built-in admin emails. Add more with ADMIN_EMAIL or ADMIN_EMAILS.
# Set them in the Netlify dashboard (Site → Environment variables).
# Scope: "All scopes" (needed at function runtime).
#
# ADMIN_SESSION_TOKEN: generate any random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_EMAIL=
ADMIN_EMAILS=
ADMIN_PASSWORD=
ADMIN_SESSION_TOKEN=

# ── Auth0 (optional — additional sign-in provider) ───────────────────
# When set, the login page shows a "Continue with Auth0" button that
# runs the OAuth 2.0 Authorization Code flow against your Auth0 tenant.
# The exchange happens server-side in netlify/functions/auth0-exchange.ts
# so the client secret never reaches the browser.
#
# The Auth0 user's email must match the admin allowlist to receive an admin
# session token.  Configure the Auth0 application with these settings:
#   • Application type: Regular Web Application
#   • Allowed Callback URLs: https://<your-site>/auth/callback
#   • Allowed Logout URLs:   https://<your-site>/auth/login
#
# Scope: server-side only (no VITE_ prefix unless noted).
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Client-side Auth0 (VITE_ prefix exposes these to the browser — public
# values only, never the client secret).  Mirror AUTH0_DOMAIN and
# AUTH0_CLIENT_ID here so the browser can build the /authorize URL.
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=

# ── Supabase (auth + database for client portal) ────────────────────
# Project ref: mdxfvxycwzauixuphjau
# Obtain API keys from: Supabase dashboard → Settings → API
#
# DATABASE_URL is used only by Drizzle Kit for local migrations.
# ⚠️  IPv4 note: the direct host (db.*.supabase.co:5432) is NOT IPv4
# compatible.  If your local machine is on IPv4 (most home networks),
# use the Session Pooler URL instead — find it in Supabase dashboard →
# Settings → Database → Connection string → "Session pooler" tab.
# Session pooler example (replace host/region from dashboard):
#   postgresql://postgres.mdxfvxycwzauixuphjau:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.mdxfvxycwzauixuphjau.supabase.co:5432/postgres
SUPABASE_URL=https://mdxfvxycwzauixuphjau.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # Keep server-side only — never expose in browser

# Client-side Supabase (VITE_ prefix exposes these to the browser — anon key only)
VITE_SUPABASE_URL=https://mdxfvxycwzauixuphjau.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ── AI / LLM (required — estimator, voice reports, chat) ────
# Anthropic Claude (paid): https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...
# OpenAI Whisper (paid, for server-side voice transcription):
# Only needed if browser Web Speech API isn't used. https://platform.openai.com → API Keys
OPENAI_API_KEY=sk-...
# Google Gemini (FREE fallback — no credit card required):
# Get a free key at: https://aistudio.google.com/app/apikey
# Used automatically when ANTHROPIC_API_KEY is not set.
GOOGLE_AI_API_KEY=AIza...

# ── Weather (optional — smart scheduling) ───────────────────
# OpenWeatherMap: register free key at https://openweathermap.org/api
# If not set, Open-Meteo (https://open-meteo.com) is used automatically —
# it is completely free with no API key required.
OPENWEATHERMAP_API_KEY=...

# ── Automation (Phase 4 — sub-contractor notifications) ─────
# n8n self-hosted or cloud: https://n8n.io
N8N_WEBHOOK_URL=https://...
N8N_API_KEY=...

# ── Billing (Phase 5 — milestone invoicing) ─────────────────
# Stripe: https://dashboard.stripe.com → Developers → API keys
# Use test keys (sk_test_ / pk_test_) during development
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Stripe webhook signing secret (from Stripe Dashboard → Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Blueprint.am integration (optional — Phase 3+) ───────────
# Enables the Blueprint connect/artifact features for Eric and clients.
# Toggle on in the client bundle:
VITE_FEATURE_BLUEPRINT=false
# OAuth credentials — obtain from blueprint.am once the developer program
# is available. Without these, the API-key flow is still available.
BLUEPRINT_CLIENT_ID=
BLUEPRINT_CLIENT_SECRET=
# Override only if blueprint.am hosts its API on a different domain.
BLUEPRINT_BASE_URL=https://blueprint.am
BLUEPRINT_API_BASE_URL=https://api.blueprint.am
# 32-byte AES-256-GCM key used to encrypt Blueprint tokens/API keys at rest.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required for any Blueprint credential to be stored.
BLUEPRINT_ENCRYPTION_KEY=

# ── Site / Application ──────────────────────────────────────
NODE_ENV=development
VITE_NETLIFY_SITE_NAME=precision-core  # Your Netlify site name (used for admin links)
# The canonical public URL of the site (no trailing slash).
# After domain transfer, update this to the custom domain.
# Example: https://precisioncorebuilders.com
VITE_SITE_URL=https://precision-core.netlify.app

# ── Developer Mode (local dev only — NEVER set true in production) ──────────
# Enables password-based dev login and mock admin bypass when Supabase is not
# configured.
#
# SETUP:
#   1. In your Supabase project, create a user:
#        Email: dev@precisioncorebuilders.com
#        Password: (choose any strong password)
#        User metadata: { "role": "admin" }
#   2. Copy .env.example → .env.local and fill in the values below.
#   3. VITE_DEV_MODE=true reveals the Developer Access panel on /auth/login.
#   4. VITE_DEV_PASSWORD is used for Supabase password login. If omitted, the
#      panel still works via a local mock admin session (no Supabase needed).
VITE_DEV_MODE=false
VITE_DEV_PASSWORD=
