# Precision Core Builders Environment Variables
# Copy this file to .env.local and fill in your actual values

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/database?schema=public

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# AI/LLM Configuration
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Voice Transcription (Whisper)
WHISPER_API_KEY=your-whisper-api-key-here

# Weather API (OpenWeatherMap)
OPENWEATHERMAP_API_KEY=your-openweathermap-api-key-here

# Automation Platform (n8n)
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/
N8N_API_KEY=your-n8n-api-key-here

# Deployment (Netlify)
NETLIFY_AUTH_TOKEN=your-netlify-token-here
NETLIFY_SITE_ID=your-site-id-here

# Application Configuration
NODE_ENV=development
PORT=3000
SESSION_SECRET=your-secret-key-minimum-32-characters-long

# OAuth (if needed for admin login)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Storage (AWS S3 or Supabase Storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-west-2
S3_BUCKET_NAME=precision-core-builders-assets

# Email/SMS Notifications (optional, via n8n or direct)
SENDGRID_API_KEY=your-sendgrid-api-key
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Error Tracking (optional)
SENTRY_DSN=your-sentry-dsn-here

# Feature Flags
ENABLE_VOICE_REPORTS=true
ENABLE_WEATHER_SCHEDULING=true
ENABLE_AI_ESTIMATOR=true
