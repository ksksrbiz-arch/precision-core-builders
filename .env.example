# ─────────────────────────────────────────────────────────────────────────────
# Precision Core Builders — Environment Variables
# Copy this file to .env.local for local development.
# In production, ALL values are set in the Netlify dashboard (Site → Environment).
# NEVER commit .env.local or any file containing real secrets to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (Auth + Database + Storage) ─────────────────────────────────────
# Get from: https://supabase.com → your project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# Client-side Supabase (VITE_ prefix required for browser access)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# Drizzle ORM (uses Supabase's direct Postgres connection string)
# Get from: Supabase → Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-us-west-2.pooler.supabase.com:6543/postgres

# ── AI / LLM ──────────────────────────────────────────────────────────────────
# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# OpenAI (Whisper transcription) — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# ── External APIs ─────────────────────────────────────────────────────────────
# OpenWeatherMap — https://openweathermap.org/api (free tier)
OPENWEATHERMAP_API_KEY=abc123...

# ── Automation (n8n) ─────────────────────────────────────────────────────────
# Your n8n instance base URL (e.g. https://your-org.app.n8n.cloud)
N8N_WEBHOOK_URL=https://your-n8n-instance.app.n8n.cloud/webhook
N8N_API_KEY=your-n8n-api-key

# ── Billing (Phase 5) ────────────────────────────────────────────────────────
# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
