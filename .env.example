# ─────────────────────────────────────────────────────────────
# Precision Core Builders — Environment Variables
# Add these to Netlify dashboard: Site → Environment variables
# For local dev: copy to .env.local (git-ignored)
# ─────────────────────────────────────────────────────────────

# ── Supabase (required for Phase 2: auth + database) ────────
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Client-side (VITE_ prefix = safe to expose in browser)
VITE_SUPABASE_URL=https://[project-ref].supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ── AI (required for Phase 3: estimator, voice reports) ─────
GEMINI_API_KEY=AIza...
OPENAI_API_KEY=sk-...          # Whisper voice transcription

# ── Weather (required for Phase 3: smart scheduling) ────────
OPENWEATHERMAP_API_KEY=...     # Free tier at openweathermap.org

# ── Automation (Phase 4: sub-contractor notifications) ──────
N8N_WEBHOOK_URL=https://...
N8N_API_KEY=...

# ── Billing (Phase 5: milestone invoicing) ──────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ── Application ─────────────────────────────────────────────
NODE_ENV=development
VITE_NETLIFY_SITE_NAME=precision-core  # Your Netlify site name (used for admin links)

# ── Developer Mode (local dev only — NEVER set true in production) ──────────
# Enables password-based dev login and mock admin bypass when Supabase is not
# configured.
#
# SETUP:
#   1. In your Supabase project, create a user:
#        Email: dev@precisioncorebuilders.com
#        Password: (choose any strong password)
#        User metadata: { "role": "admin" }
#   2. Copy .env.example → .env.local and fill in the values below.
#   3. VITE_DEV_MODE=true reveals the Developer Access panel on /auth/login.
#   4. VITE_DEV_PASSWORD is used for Supabase password login. If omitted, the
#      panel still works via a local mock admin session (no Supabase needed).
VITE_DEV_MODE=false
VITE_DEV_PASSWORD=
