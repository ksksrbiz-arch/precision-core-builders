    "sitemap": "tsx scripts/generate-sitemap.ts",
    "start": "echo \"Production runs on Netlify Functions — use netlify dev locally\"",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
