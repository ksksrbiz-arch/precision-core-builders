{
  "name": "Precision Core Builders — Digital Foreman",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bullseye",

  // Features installed on top of the base image
  "features": {
    // Supabase CLI (latest stable)
    "ghcr.io/rio/features/supabase-cli:1": {},
    // GitHub CLI — useful for PR/branch workflows from terminal
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // VS Code extensions auto-installed
  "customizations": {
    "vscode": {
      "extensions": [
        // TypeScript & React
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        // Supabase
        "supabase.vscode-supabase",
        // Git & GitHub
        "github.vscode-pull-request-github",
        "eamodio.gitlens",
        // Env files
        "mikestead.dotenv",
        // Better DX
        "streetsidesoftware.code-spell-checker",
        "christian-kohler.path-intellisense",
        "formulahendry.auto-rename-tag"
      ],
      "settings": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "editor.tabSize": 2,
        "typescript.preferences.importModuleSpecifier": "non-relative",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  // Lifecycle hooks
  "onCreateCommand": "bash .devcontainer/on-create.sh",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",

  // Forward Vite dev server + Netlify CLI port + Supabase studio
  "forwardPorts": [3000, 8888, 54321, 54323],
  "portsAttributes": {
    "3000": { "label": "Vite Dev Server", "onAutoForward": "notify" },
    "8888": { "label": "Netlify Dev", "onAutoForward": "notify" },
    "54321": { "label": "Supabase API", "onAutoForward": "silent" },
    "54323": { "label": "Supabase Studio", "onAutoForward": "notify" }
  },

  // Mount the repo as the workspace
  "workspaceFolder": "/workspaces/precision-core-builders",

  // Env vars available in the container (non-secret)
  "remoteEnv": {
    "NODE_ENV": "development",
    "PNPM_VERSION": "10.4.1"
  }
}
