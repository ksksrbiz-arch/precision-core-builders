# tRPC — all procedures route to the single trpc function
/api/trpc/*  /.netlify/functions/trpc  200

# Other API calls → Netlify Functions (1:1 mapping)
/api/*  /.netlify/functions/:splat  200

# PWA files — serve directly
/sw.js           /sw.js           200
/manifest.json   /manifest.json   200
/offline.html    /offline.html    200

# SPA fallback — all other routes → index.html
/*  /index.html  200
